+] as const);
+
+/**
+ * Die 64 Aufgaben des dritten Durchlaufs.
+ *
+ * Die Liste ist verbindlich und wird vollständig zufällig angeordnet.
+ * Jede Aufgabe darf in diesem Durchlauf genau einmal vorkommen.
+ */
+export const ROUND_THREE_TASKS = Object.freeze([
+  task(2, 2),
+  task(3, 2),
