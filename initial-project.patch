+  task(8, 3),
+  task(3, 8),
+  task(9, 3),
+  task(3, 9),
+  task(4, 4),
+  task(5, 4),
+  task(4, 5),
+  task(6, 4),
+  task(4, 6),
+  task(7, 4),
+  task(4, 7),
+  task(8, 4),
+  task(4, 8),
+  task(9, 4),
+  task(4, 9),
+  task(5, 5),
