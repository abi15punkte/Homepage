@@ -0,0 +1,51 @@
+import {
+  ROUND_THREE_TASKS,
+  TASK_POOLS,
+  type Task,
+  reverseFactors
+} from "./tasks";
+
+export type RandomSource = () => number;
+
+export const systemRandom: RandomSource = Math.random;
+
+export function shuffled<T>(
+  values: readonly T[],
+  random: RandomSource = systemRandom
+): T[] {
+  const result = [...values];
+
+  for (let i = result.length - 1; i > 0; i -= 1) {
+    const j = Math.floor(random() * (i + 1));
+    [result[i], result[j]] = [result[j], result[i]];
+  }
+
+  return result;
+}
+
+export function createRoundOne(
+  random: RandomSource = systemRandom
+): Task[][] {
+  return TASK_POOLS.map((pool) => shuffled(pool, random));
+}
+
+export function createRoundTwo(
+  random: RandomSource = systemRandom
+): Task[][] {
+  return TASK_POOLS.map((pool) =>
+    shuffled(pool.map(reverseFactors), random)
+  );
+}
+
+export function createRoundThree(
+  random: RandomSource = systemRandom
+): Task[] {
+  return shuffled(ROUND_THREE_TASKS, random);
+}
+
+export function flattenPools(
+  pools: readonly (readonly Task[])[]
+): Task[] {
+  return pools.flatMap((pool) => [...pool]);
+}
+
+export function createAllRounds(
+  random: RandomSource = systemRandom
+): {
+  readonly roundOne: Task[][];
+  readonly roundTwo: Task[][];
+  readonly roundThree: Task[];
+} {
+  return {
+    roundOne: createRoundOne(random),
+    roundTwo: createRoundTwo(random),
+    roundThree: createRoundThree(random)
+  };
+}
