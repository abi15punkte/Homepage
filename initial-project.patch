+export const BASE_SCORE = 100;
+
+export function basePoints(elapsedSeconds: number): number {
+  if (!Number.isFinite(elapsedSeconds) || elapsedSeconds < 0) {
+    throw new RangeError(
+      "elapsedSeconds must be a finite non-negative number"
+    );
+  }
+
+  return BASE_SCORE * Math.pow(0.5, elapsedSeconds / 2);
+}
+
+/**
+ * Der Multiplikator wird vor dem finalen Runden angewendet.
+ * Dadurch ist die Rundung für identische Eingaben deterministisch.
+ */
+export function awardedPoints(
+  elapsedSeconds: number,
+  multiplier: number
+): number {
+  if (!Number.isFinite(multiplier) || multiplier < 1) {
+    throw new RangeError(
+      "multiplier must be a finite number >= 1"
+    );
+  }
+
+  return Math.round(basePoints(elapsedSeconds) * multiplier);
+}
diff --git a/src/domain/multiplier.ts b/src/domain/multiplier.ts
new file mode 100644
index 0000000..8c20fd8
--- /dev/null
+++ b/src/domain/multiplier.ts
@@ -0,0 +1,23 @@
+export function multiplierForStreak(streak: number): number {
+  if (!Number.isInteger(streak) || streak < 0) {
+    throw new RangeError(
+      "streak must be a non-negative integer"
+    );
+  }
+
+  if (streak >= 20) {
+    return 5;
+  }
+
+  if (streak >= 10) {
+    return 3;
+  }
+
+  if (streak >= 3) {
+    return 2;
+  }
+
+  return 1;
+}
