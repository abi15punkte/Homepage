+ * Die sechs verbindlichen Aufgabenpools aus der Projektspezifikation.
+ *
+ * Diese Definition darf nicht durch Zufallslogik verändert werden.
+ */
+export const TASK_POOLS = Object.freeze([
+  Object.freeze([
+    task(2, 2),
+    task(3, 2),
+    task(4, 2),
+    task(5, 2),
+    task(3, 3),
+    task(4, 4)
+  ]),
+  Object.freeze([
+    task(6, 2),
+    task(4, 3),
+    task(5, 5),
+    task(6, 5),
+    task(7, 2),
+    task(5, 3)
+  ]),
+  Object.freeze([
+    task(8, 2),
+    task(9, 2),
+    task(6, 3),
+    task(5, 4),
+    task(6, 4),
+    task(7, 3)
+  ]),
+  Object.freeze([
+    task(8, 3),
+    task(9, 3),
+    task(7, 4),
+    task(8, 4),
+    task(9, 4),
+    task(6, 6)
+  ]),
+  Object.freeze([
+    task(7, 5),
+    task(8, 5),
+    task(9, 5),
+    task(7, 7),
+    task(8, 8),
+    task(9, 9)
+  ]),
+  Object.freeze([
+    task(7, 6),
+    task(8, 6),
+    task(9, 6),
+    task(8, 7),
+    task(9, 8),
+    task(9, 7)
