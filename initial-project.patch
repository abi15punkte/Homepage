+import { describe, expect, it } from "vitest";
+import {
+  ROUND_THREE_TASKS,
+  TASK_POOLS,
+  taskKey
+} from "../src/domain/tasks";
+import {
+  createRoundOne,
+  createRoundTwo,
+  createRoundThree,
+  flattenPools
+} from "../src/domain/rounds";
+
+const poolKeys = (
+  pool: readonly { a: number; b: number }[]
+) => pool.map(taskKey);
+
+describe("Aufgabenpools", () => {
+  it("enthält exakt sechs Pools mit jeweils sechs Aufgaben", () => {
+    expect(TASK_POOLS).toHaveLength(6);
+
+    for (const pool of TASK_POOLS) {
+      expect(pool).toHaveLength(6);
+    }
+  });
+
+  it("enthält die sechs verbindlichen Pools", () => {
+    expect(TASK_POOLS.map(poolKeys)).toEqual([
+      ["2x2", "3x2", "4x2", "5x2", "3x3", "4x4"],
+      ["6x2", "4x3", "5x5", "6x5", "7x2", "5x3"],
+      ["8x2", "9x2", "6x3", "5x4", "6x4", "7x3"],
+      ["8x3", "9x3", "7x4", "8x4", "9x4", "6x6"],
+      ["7x5", "8x5", "9x5", "7x7", "8x8", "9x9"],
+      ["7x6", "8x6", "9x6", "8x7", "9x8", "9x7"]
+    ]);
+  });
+
+  it("enthält im dritten Durchlauf exakt 64 Aufgaben", () => {
+    expect(ROUND_THREE_TASKS).toHaveLength(64);
+    expect(new Set(ROUND_THREE_TASKS.map(taskKey)).size).toBe(64);
+  });
+
+  it("enthält im dritten Durchlauf exakt die verbindliche Aufgabenmenge", () => {
+    const expected = [
+      "2x2", "3x2", "2x3", "4x2", "2x4", "5x2", "2x5",
+      "6x2", "2x6", "7x2", "2x7", "8x2", "2x8", "9x2",
+      "2x9", "3x3", "4x3", "3x4", "5x3", "3x5", "6x3",
+      "3x6", "7x3", "3x7", "8x3", "3x8", "9x3", "3x9",
+      "4x4", "5x4", "4x5", "6x4", "4x6", "7x4", "4x7",
+      "8x4", "4x8", "9x4", "4x9", "5x5", "6x5", "5x6",
+      "7x5", "5x7", "8x5", "5x8", "9x5", "5x9", "6x6",
+      "7x6", "6x7", "8x6", "6x8", "9x6", "6x9", "7x7",
+      "8x7", "7x8", "9x7", "7x9", "8x8", "9x8", "8x9",
+      "9x9"
+    ].sort();
+
+    expect(ROUND_THREE_TASKS.map(taskKey).sort()).toEqual(expected);
+  });
+
+  it("spielt jede Quadrataufgabe im dritten Durchlauf genau einmal", () => {
+    const squares = [
+      "2x2",
+      "3x3",
+      "4x4",
+      "5x5",
+      "6x6",
+      "7x7",
+      "8x8",
+      "9x9"
+    ];
+
+    const actual = ROUND_THREE_TASKS
+      .map(taskKey)
+      .filter((key) => squares.includes(key));
+
+    expect(actual.sort()).toEqual(squares.sort());
+  });
+});
+
+describe("Durchlauf 1", () => {
+  it("besteht aus exakt 36 Aufgaben", () => {
+    const round = createRoundOne(() => 0.5);
+    const tasks = flattenPools(round);
+
+    expect(tasks).toHaveLength(36);
+    expect(new Set(tasks.map(taskKey)).size).toBe(36);
+  });
+});
+
+describe("Durchlauf 2", () => {
+  it("besteht aus exakt 36 Aufgaben", () => {
+    const round = createRoundTwo(() => 0.5);
+    const tasks = flattenPools(round);
+
+    expect(tasks).toHaveLength(36);
+  });
+
+  it("vertauscht die Faktoren", () => {
+    const round = createRoundTwo(() => 0.5);
+    const actual = flattenPools(round)
+      .map(taskKey)
+      .sort();
+
+    const expected = [
+      "2x2", "2x3", "2x4", "2x5", "3x3", "4x4",
+      "2x6", "3x4", "5x5", "5x6", "2x7", "3x5",
+      "2x8", "2x9", "3x6", "4x5", "4x6", "3x7",
