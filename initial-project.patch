+
+describe("Durchlauf 3", () => {
+  it("enthält exakt jede der 64 definierten Aufgaben einmal", () => {
+    const round = createRoundThree(() => 0.5);
+
+    expect(round).toHaveLength(64);
+    expect(new Set(round.map(taskKey)).size).toBe(64);
+    expect(new Set(round.map(taskKey))).toEqual(
+      new Set(ROUND_THREE_TASKS.map(taskKey))
