+import { describe, expect, it } from "vitest";
+import {
+  awardedPoints,
+  basePoints
+} from "../src/domain/scoring";
+import {
+  multiplierForStreak
+} from "../src/domain/multiplier";
+
+describe("Punktesystem", () => {
+  it("liefert bei 0 Sekunden 100 Punkte", () => {
+    expect(basePoints(0)).toBe(100);
+  });
+
+  it("berechnet 0,5 Sekunden kontinuierlich", () => {
+    expect(basePoints(0.5)).toBeCloseTo(
+      100 * Math.pow(0.5, 0.25),
+      12
+    );
+  });
+
+  it("berechnet 1 Sekunde", () => {
+    expect(basePoints(1)).toBeCloseTo(
+      100 * Math.pow(0.5, 0.5),
+      12
+    );
+  });
+
+  it("liefert nach 2 Sekunden exakt 50 Basispunkte", () => {
+    expect(basePoints(2)).toBe(50);
+  });
+
+  it("liefert nach 4 Sekunden exakt 25 Basispunkte", () => {
+    expect(basePoints(4)).toBe(25);
+  });
+
+  it("wendet den Multiplikator vor dem Runden an", () => {
+    expect(awardedPoints(2, 2)).toBe(100);
+    expect(awardedPoints(4, 3)).toBe(75);
+  });
+});
+
+describe("Serienmultiplikator", () => {
+  it("bleibt bei 1 bis 2 richtigen Antworten bei 1", () => {
+    expect(multiplierForStreak(0)).toBe(1);
+    expect(multiplierForStreak(1)).toBe(1);
+    expect(multiplierForStreak(2)).toBe(1);
+  });
+
+  it("ist ab 3 richtigen Antworten 2", () => {
+    expect(multiplierForStreak(3)).toBe(2);
+    expect(multiplierForStreak(9)).toBe(2);
+  });
+
+  it("ist ab 10 richtigen Antworten 3", () => {
+    expect(multiplierForStreak(10)).toBe(3);
+    expect(multiplierForStreak(19)).toBe(3);
+  });
+
+  it("ist ab 20 richtigen Antworten 5", () => {
+    expect(multiplierForStreak(20)).toBe(5);
+    expect(multiplierForStreak(100)).toBe(5);
+  });
+});
